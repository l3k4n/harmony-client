    "@capacitor/core": "^8.2.0",
    "@faker-js/faker": "^10.3.0",
    "@solidjs/router": "^0.15.4",
    "solid-js": "^1.9.10",
    "solid-transition-group": "^0.3.0",
    "video.js": "^8.23.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.2.0",
    "@types/node": "^22.0.0",
    "browserlist": "^1.0.2",
    "lightningcss": "^1.31.1",
    "typescript": "^5.7.0",
    "vite": "^7.3.1",
    "vite-plugin-solid": "^2.11.10"
  }
}
