{
  "name": "my-arr-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tv": "VITE_TARGET_TV=1 vite",
    "format": "npx @biomejs/biome format ./src --write",
